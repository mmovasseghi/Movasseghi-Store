{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=movasseghi.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "movasseghi.ir;www.movasseghi.ir",
  "PathBase": "",
