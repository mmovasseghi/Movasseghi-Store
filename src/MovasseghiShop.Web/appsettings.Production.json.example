  },
  "GoogleSearchConsole": {
    "PropertyUrl": "https://movasseghi.ir/",
    "ServiceAccountKeyPath": "App_Data/gsc-service-account.json",
    "SiteVerificationMeta": ""
  },
  "SerpApi": {
    "ApiKey": "",
    "AutoSync": false
  },
  "Security": {
    "CheckoutHmacSecret": "CHANGE_ME_LONG_RANDOM_STRING"
  }
}
