@{
    var active = ViewBag.PremiumActive as bool? ?? false;
}
<div class="cart-premium-card @(active ? "cart-premium-card--active" : "")" data-cart-premium aria-label="سطح ویژه هماهنگی">
    <div class="cart-premium-card__glow" aria-hidden="true"></div>
    <div class="cart-premium-card__sparkles" aria-hidden="true">
        <span></span><span></span><span></span>
    </div>
    <div class="cart-premium-card__inner">
        <header class="cart-premium-card__head">
            <span class="cart-premium-card__badge" aria-hidden="true">✦</span>
            <span class="cart-premium-card__title">سطح ویژه</span>
        </header>
        <p class="cart-premium-card__copy">
            سطح ویژه (<strong>@WholesaleRules.PremiumCartons کارتن</strong> یا <strong>@WholesaleRules.FormatPremiumAmount() تومان</strong>):
            برای تخفیف <strong>بیش از @(WholesaleRules.MaxAutoDiscountPercent)٪</strong> و ارسال رایگان تهران
            با شماره درج‌شده تماس برقرار کنید.
        </p>
        <div class="cart-premium-card__thresholds">
            <span class="cart-premium-card__chip">@WholesaleRules.PremiumCartons کارتن</span>
            <span class="cart-premium-card__or">یا</span>
            <span class="cart-premium-card__chip">@WholesaleRules.FormatPremiumAmount() تومان</span>
        </div>
        <ul class="cart-premium-card__perks">
            <li>تخفیف <strong>بیش از @(WholesaleRules.MaxAutoDiscountPercent)٪</strong></li>
            <li>ارسال <strong>رایگان</strong> تهران</li>
        </ul>
        <a href="tel:@WholesaleRules.CoordinationPhone" class="cart-premium-card__cta">
            <span class="cart-premium-card__cta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            </span>
            <span class="cart-premium-card__cta-text">تماس هماهنگی</span>
            <strong class="cart-premium-card__cta-phone">@WholesaleRules.CoordinationPhone</strong>
        </a>
    </div>
</div>
