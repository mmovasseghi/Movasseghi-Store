<form id="msAntiForgery" class="ms-sr-only" aria-hidden="true">@Html.AntiForgeryToken()</form>

@* GSAP از jsDelivr می‌آمد: یک اتصال شخص‌ثالث اضافه، بدون کش طولانی‌مدت خودمان
   و بدون defer (پارسر را متوقف می‌کرد). حالا محلی و deferred است؛ ترتیب اجرای
   اسکریپت‌ها با defer دقیقاً همان ترتیب سند می‌ماند. *@
<script defer src="~/js/vendor/gsap.min.js" asp-append-version="true"></script>
<script defer src="~/js/vendor/ScrollTrigger.min.js" asp-append-version="true"></script>
@if (isLocalTunnel)
{
    <script type="text/tunnel" data-src="@Url.Content("~/js/auth.js")"></script>
    <script type="text/tunnel" data-src="@Url.Content("~/js/site.js")"></script>
    <script type="text/tunnel" data-src="@Url.Content("~/js/desktop.js")"></script>
}
else
{
    <script defer src="~/js/auth.js" asp-append-version="true"></script>
    <script defer src="~/js/site.js" asp-append-version="true"></script>
    <script defer src="~/js/product-card-dual.js" asp-append-version="true"></script>
    <script defer src="~/js/desktop.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
