@inject MovasseghiShop.Web.Services.ICartService CartService
@inject IConfiguration Config
@using MovasseghiShop.Web.Services
@{
    var title = ViewData["Title"]?.ToString() ?? SiteKeywordStrategy.SiteTitle;
    var metaDescription = ViewData["MetaDescription"]?.ToString() ?? SiteKeywordStrategy.SiteDescription;
    var metaKeywords = ViewData["MetaKeywords"] as string ?? SiteKeywordStrategy.MetaKeywords;
    var isHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home";
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isCatalog = ctrl == "Catalog";
    var isBlog = ctrl == "Blog";
    var isNews = ctrl == "News";
    var isAccount = ctrl == "Account";
    var isOrder = ctrl == "Order";
    var isLocalTunnel = Context.Request.Host.Host.EndsWith(".loca.lt", StringComparison.OrdinalIgnoreCase);
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var cartItemCount = CartService.GetItemCount(Context);
    var cartAriaLabel = cartItemCount > 0 ? $"سبد خرید ({cartItemCount} قلم)" : "سبد خرید";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@title</title>
    <meta name="description" content="@metaDescription" />
    <meta name="keywords" content="@metaKeywords" />
    @{
        var gscVerify = Config["GoogleSearchConsole:SiteVerificationMeta"]?.Trim();
        if (!string.IsNullOrWhiteSpace(gscVerify))
        {
            <meta name="google-site-verification" content="@gscVerify" />
        }
    }
    @if (ViewData["CanonicalUrl"] is string canonical && !string.IsNullOrWhiteSpace(canonical))
    {
        <link rel="canonical" href="@canonical" />
    }
    @if (ViewData["OgTitle"] is string ogTitle)
    {
        <meta property="og:title" content="@ogTitle" />
        <meta property="og:description" content="@(ViewData["OgDescription"] ?? metaDescription)" />
        <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
        <meta property="og:locale" content="fa_IR" />
        @if (ViewData["OgUrl"] is string ogUrl) { <meta property="og:url" content="@ogUrl" /> }
        @if (ViewData["OgImage"] is string ogImg) { <meta property="og:image" content="@ogImg" /> }
    }
    <meta name="twitter:card" content="summary_large_image" />
    @if (ViewData["OgTitle"] is string twTitle)
    {
        <meta name="twitter:title" content="@twTitle" />
        <meta name="twitter:description" content="@(ViewData["OgDescription"] ?? metaDescription)" />
        @if (ViewData["OgImage"] is string twImg) { <meta name="twitter:image" content="@twImg" /> }
    }
    <meta name="theme-color" content="#2f4a3e" />
    @* فونت روی همین دامنه میزبانی می‌شود: قبلاً دو اتصال جداگانه به
       fonts.googleapis.com و fonts.gstatic.com لازم بود و CSS فونت هم رندر را
       بلاک می‌کرد. نسخه variable هر شش وزن را در یک فایل دارد. *@
    <link rel="preload" href="~/fonts/Vazirmatn-var.woff2" as="font" type="font/woff2" crossorigin asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" media="@(isLocalTunnel ? "not all" : null)" />
    <link rel="stylesheet" href="~/css/prose.css" asp-append-version="true" media="@(isLocalTunnel ? "not all" : null)" />
    <link rel="stylesheet" href="~/css/ux-cart.css" asp-append-version="true" media="@(isLocalTunnel ? "not all" : null)" />
    <link rel="stylesheet" href="~/css/ux-mobile.css" asp-append-version="true" media="@(isLocalTunnel ? "not all" : null)" />
    <link rel="stylesheet" href="~/css/ux-desktop.css" asp-append-version="true" media="@(isLocalTunnel ? "not all" : "(min-width: 768px)")" />
    <link rel="stylesheet" href="~/css/ux-product-dual.css" asp-append-version="true" media="@(isLocalTunnel ? "not all" : null)" />
    @await RenderSectionAsync("Head", required: false)
    @if (isLocalTunnel)
    {
        <script>
        (function () {
          if (!/\.loca\.lt$/i.test(location.hostname)) return;
          var bypass = { 'Bypass-Tunnel-Reminder': 'true' };
          document.querySelectorAll('link[rel="stylesheet"][href]').forEach(function (link) {
            fetch(link.href, { headers: bypass })
              .then(function (r) { return r.text(); })
              .then(function (css) {
                var style = document.createElement('style');
                style.textContent = css;
                var media = link.getAttribute('media');
                if (media && media !== 'not all') style.media = media;
                document.head.appendChild(style);
              })
              .catch(function () {});
          });
          function loadTunnelScripts() {
            function loadScript(src) {
              return fetch(src, { headers: bypass })
                .then(function (r) { return r.text(); })
                .then(function (code) {
                  var script = document.createElement('script');
                  script.textContent = code;
                  document.body.appendChild(script);
                });
            }
            var queue = Array.prototype.slice.call(
              document.querySelectorAll('script[type="text/tunnel"][data-src]')
            );
            queue.reduce(function (chain, node) {
              return chain.then(function () { return loadScript(node.getAttribute('data-src')); });
            }, Promise.resolve());
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', loadTunnelScripts);
          } else {
            loadTunnelScripts();
          }
        })();
        </script>
    }
</head>
