@model Product
@inject IWebHostEnvironment Env
@using MovasseghiShop.Web.Services
@{
    var sellable = ProductStorefrontResolver.GetSellableVariants(Model.Variants);
    var price = ProductStorefrontResolver.GetMinPrice(Model.Variants);
    var priceFrom = sellable.Count > 0 && ProductStorefrontResolver.UseFromPricePrefix(sellable);
}
<article class="ms-product">
    <a href="@AppPath.H($"/Shop/Product/{Model.Slug}", Context)" class="ms-product-link">
        <partial name="_ProductImageStageFromProduct" model="Model" />
        <div class="ms-product-body">
            @if (!string.IsNullOrEmpty(Model.ProductCode)) { <span class="ms-product-code">کد @Model.ProductCode</span> }
            <h3 class="ms-product-title">@Model.Name</h3>
            <div class="ms-product-meta">
                @if (Model.CapacityCc.HasValue) { <span>@Model.CapacityCc cc</span> }
                @if (Model.CompartmentCount.HasValue) { <span>@Model.CompartmentCount خانه</span> }
                @if (Model.MicrowaveSafe) { <span>مایکروویو</span> }
            </div>
            @if (price.HasValue)
            {
                <div class="ms-product-price"><span>@(priceFrom ? "از " : "")@SlugHelper.FormatToman(price.Value)</span> <small>تومان</small></div>
            }
            else
            {
                <div class="ms-product-inquiry">استعلام قیمت</div>
            }
        </div>
    </a>
</article>
