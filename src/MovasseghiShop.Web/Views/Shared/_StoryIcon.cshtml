@model string
@{
    var id = $"ic{Guid.NewGuid():N}"[..8];
    var key = Model;
}
<svg class="ms-icon-svg" viewBox="0 0 48 48" width="44" height="44" fill="none" aria-hidden="true">
    <defs>
        <linearGradient id="g1@(id)" x1="4" y1="4" x2="44" y2="44">
            <stop offset="0%" stop-color="#5f8a72"/>
            <stop offset="100%" stop-color="#3d5a4c"/>
        </linearGradient>
        <linearGradient id="g2@(id)" x1="0" y1="0" x2="48" y2="48">
            <stop offset="0%" stop-color="#d4b85a"/>
            <stop offset="100%" stop-color="#c9a84c"/>
        </linearGradient>
        <linearGradient id="bg@(id)" x1="8" y1="8" x2="40" y2="40">
            <stop offset="0%" stop-color="#f4faf6"/>
            <stop offset="100%" stop-color="#dce8e0"/>
        </linearGradient>
        <filter id="sh@(id)" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="2" stdDeviation="1.5" flood-color="#3d5a4c" flood-opacity=".18"/>
        </filter>
    </defs>
    <circle cx="24" cy="24" r="21" fill="url(#bg@(id))"/>
    <circle cx="24" cy="24" r="21" fill="url(#g1@(id))" opacity=".08"/>
    <g filter="url(#sh@(id))">
    @switch (key)
    {
        case "all":
            <path d="M14 16h20l-1.5 22H15.5L14 16z" fill="url(#g1@(id))"/>
            <path d="M18 16V13a6 6 0 0 1 12 0v3" stroke="url(#g2@(id))" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="20" cy="22" r="1.5" fill="#fff" opacity=".7"/>
            <circle cx="28" cy="22" r="1.5" fill="#fff" opacity=".7"/>
            break;
        case "wholesale":
            <path d="M8 22h32l-3 18H11L8 22z" fill="url(#g1@(id))"/>
            <path d="M8 22l16-10 16 10" stroke="url(#g2@(id))" stroke-width="2.5" stroke-linejoin="round" fill="none"/>
            <rect x="20" y="28" width="8" height="12" rx="1" fill="url(#g2@(id))"/>
            <path d="M16 18h16" stroke="#fff" stroke-width="1.5" opacity=".4" stroke-linecap="round"/>
            break;
        case "official":
            <circle cx="24" cy="24" r="13" fill="url(#g1@(id))" opacity=".15"/>
            <path d="M24 11l3.2 6.5 7.2 1-5.2 5.1 1.2 7.1L24 27l-6.4 3.7 1.2-7.1-5.2-5.1 7.2-1z" fill="url(#g2@(id))"/>
            <path d="M24 11l3.2 6.5 7.2 1-5.2 5.1 1.2 7.1L24 27l-6.4 3.7 1.2-7.1-5.2-5.1 7.2-1z" stroke="url(#g1@(id))" stroke-width=".8" opacity=".5"/>
            break;
        case "کاسه":
            <ellipse cx="24" cy="30" rx="14" ry="5" fill="url(#g1@(id))" opacity=".25"/>
            <path d="M10 22c0-7 6.5-12 14-12s14 5 14 12v3H10v-3z" fill="url(#g1@(id))"/>
            <path d="M14 25h20v3c0 5.5-4.5 9.5-10 9.5S14 33.5 14 28v-3z" fill="url(#g2@(id))" opacity=".85"/>
            <path d="M17 19c2-2 5-3 7-3s5 1 7 3" stroke="#fff" stroke-width="1.5" stroke-linecap="round" opacity=".5"/>
            break;
        case "ظرف چندخانه":
            <rect x="9" y="15" width="30" height="22" rx="4" fill="url(#g1@(id))"/>
            <path d="M9 23h30M19 15v22M29 15v22" stroke="#fff" stroke-width="1.8" opacity=".45"/>
            <rect x="11" y="17" width="6" height="4" rx="1" fill="url(#g2@(id))" opacity=".6"/>
            <rect x="21" y="17" width="6" height="4" rx="1" fill="url(#g2@(id))" opacity=".6"/>
            break;
        case "لیوان":
            <path d="M15 11h18l-2 26H17L15 11z" fill="url(#g1@(id))"/>
            <path d="M33 14h3.5c1.8 0 3 1.5 3 3.5v5" stroke="url(#g2@(id))" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M19 18h10" stroke="#fff" stroke-width="1.5" stroke-linecap="round" opacity=".45"/>
            <ellipse cx="24" cy="11" rx="9" ry="2" fill="url(#g2@(id))" opacity=".5"/>
            break;
        case "سطل":
            <path d="M13 19h22l-2.5 21H15.5L13 19z" fill="url(#g1@(id))"/>
            <path d="M11 19h26" stroke="url(#g2@(id))" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M17 15h14" stroke="url(#g2@(id))" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M20 24h8M20 29h8" stroke="#fff" stroke-width="1.2" opacity=".35" stroke-linecap="round"/>
            break;
        case "ظرف":
            <rect x="10" y="17" width="28" height="19" rx="5" fill="url(#g1@(id))"/>
            <path d="M8 21h32" stroke="url(#g2@(id))" stroke-width="2.5" stroke-linecap="round"/>
            <ellipse cx="24" cy="21" rx="14" ry="3" fill="#fff" opacity=".12"/>
            <path d="M16 26h16" stroke="#fff" stroke-width="1.2" opacity=".3" stroke-linecap="round"/>
            break;
        case "قاشق":
            <path d="M19 9c0 5.5-3.5 9-3.5 15v13" stroke="url(#g1@(id))" stroke-width="3" stroke-linecap="round"/>
            <path d="M15.5 37h7" stroke="url(#g2@(id))" stroke-width="3" stroke-linecap="round"/>
            <ellipse cx="31" cy="14" rx="7" ry="9" fill="url(#g2@(id))"/>
            <ellipse cx="31" cy="14" rx="4" ry="5.5" fill="#fff" opacity=".2"/>
            break;
        case "نی":
            <path d="M21 7v34" stroke="url(#g1@(id))" stroke-width="3" stroke-linecap="round"/>
            <path d="M21 7c7.5 0 11.5 3.5 11.5 9.5S28.5 26 21 26" stroke="url(#g2@(id))" stroke-width="2.5" stroke-linecap="round" fill="none"/>
            <circle cx="21" cy="7" r="2" fill="url(#g2@(id))"/>
            break;
        case "بشقاب":
            <ellipse cx="24" cy="26" rx="15" ry="5" fill="url(#g1@(id))" opacity=".3"/>
            <ellipse cx="24" cy="24" rx="15" ry="5" fill="url(#g1@(id))"/>
            <ellipse cx="24" cy="24" rx="10" ry="3" fill="url(#g2@(id))" opacity=".4"/>
            break;
        case "دیس":
            <ellipse cx="24" cy="28" rx="16" ry="4" fill="url(#g1@(id))" opacity=".25"/>
            <path d="M8 24h32" stroke="url(#g2@(id))" stroke-width="2.5" stroke-linecap="round"/>
            <ellipse cx="24" cy="24" rx="16" ry="6" fill="url(#g1@(id))"/>
            break;
        case "چنگال":
            <path d="M20 9v29" stroke="url(#g1@(id))" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M15 37h10" stroke="url(#g2@(id))" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M17 9v8M20 9v8M23 9v8" stroke="url(#g2@(id))" stroke-width="2" stroke-linecap="round"/>
            break;
        case "کیک‌خوری":
        case "کیک خوری":
            <rect x="14" y="28" width="20" height="3" rx="1" fill="url(#g2@(id))"/>
            <path d="M24 28V16" stroke="url(#g1@(id))" stroke-width="2.5"/>
            <ellipse cx="24" cy="14" rx="12" ry="3" fill="url(#g1@(id))"/>
            <ellipse cx="24" cy="13" rx="8" ry="2" fill="url(#g2@(id))" opacity=".5"/>
            break;
        case "سایر":
            <rect x="12" y="12" width="10" height="10" rx="2" fill="url(#g1@(id))"/>
            <rect x="26" y="12" width="10" height="10" rx="2" fill="url(#g2@(id))" opacity=".7"/>
            <rect x="12" y="26" width="10" height="10" rx="2" fill="url(#g2@(id))" opacity=".7"/>
            <rect x="26" y="26" width="10" height="10" rx="2" fill="url(#g1@(id))" opacity=".5"/>
            break;
        default:
            <circle cx="24" cy="24" r="10" fill="url(#g1@(id))" opacity=".2"/>
            <path d="M24 17v14M17 24h14" stroke="url(#g1@(id))" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="24" cy="24" r="3" fill="url(#g2@(id))"/>
            break;
    }
    </g>
</svg>
