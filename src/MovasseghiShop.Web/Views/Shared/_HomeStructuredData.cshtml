@using MovasseghiShop.Web.Services
@model string
@{
    var homeUrl = Model;
    var metaDescription = ViewData["MetaDescription"]?.ToString();
    var pageTitle = ViewData["Title"]?.ToString();
    var logo = AppPath.Absolute("/images/brand/originallogo.png", Context);
    var searchUrl = $"{homeUrl.TrimEnd('/')}{AppPath.H("/Catalog", Context)}?q={{search_term_string}}";
    var blocks = StorefrontHomeJsonLd.BuildBlocks(homeUrl, metaDescription, pageTitle, logo, searchUrl);
}
@foreach (var block in blocks)
{
    @StorefrontJsonLd.Script(block)
}
