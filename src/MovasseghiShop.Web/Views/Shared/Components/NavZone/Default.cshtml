@model List<MovasseghiShop.Web.Models.Entities.NavItem>
@{
    var zone = ViewData["zone"] as string
        ?? ViewContext.ViewData["zone"] as string
        ?? "header";
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isHome = ctrl == "Home";
    var isCatalog = ctrl == "Catalog";
    var isBlog = ctrl == "Blog";
    var isNews = ctrl == "News";
    var isOrder = ctrl == "Order";
    string ActiveClass(string url)
    {
        if (url == "/" && isHome) return "is-active";
        if (url.StartsWith("/Catalog") && isCatalog) return "is-active";
        if (url.StartsWith("/Blog") && isBlog) return "is-active";
        if (url.StartsWith("/News") && isNews) return "is-active";
        if (url.StartsWith("/Order") && isOrder) return "is-active";
        return "";
    }
}
@if (zone == "header")
{
    @foreach (var item in Model)
    {
        <a href="@item.Url" class="@ActiveClass(item.Url)">@item.Label</a>
    }
}
else if (zone.StartsWith("drawer"))
{
    @foreach (var item in Model)
    {
        <a href="@item.Url" class="ms-drawer-link @ActiveClass(item.Url)" data-drawer-link>
            @if (!string.IsNullOrEmpty(item.Icon))
            {
                <span class="ms-drawer-link-icon" aria-hidden="true">@item.Icon</span>
            }
            <span class="ms-drawer-link-text">@item.Label</span>
            <span class="ms-drawer-link-go" aria-hidden="true">›</span>
        </a>
    }
}
else if (zone.StartsWith("footer"))
{
    @foreach (var item in Model)
    {
        <li><a href="@item.Url">@item.Label</a></li>
    }
}
