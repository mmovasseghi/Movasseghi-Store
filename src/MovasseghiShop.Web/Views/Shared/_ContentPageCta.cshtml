<section class="ct-closing ms-reveal" aria-label="تماس و سفارش عمده">
    <div class="ct-closing-glow" aria-hidden="true"></div>
    <div class="ct-closing-spark" aria-hidden="true">✦</div>
    <div class="ct-closing-inner">
        <span class="ct-closing-badge">🌿 پخش عمده · فروشگاه موثقی</span>
        <h2>آماده سفارش عمده ظروف گیاهی هستید؟</h2>
        <p>مشاوره رایگان — حداقل سفارش <strong>@WholesaleRules.FormatMinAmount() تومان</strong> — تخفیف پلکانی تا @(WholesaleRules.MaxAutoDiscountPercent)٪</p>
        <div class="ct-closing-trust">
            <span>✅ اصل کارخانه آملون</span>
            <span>📦 بسته‌بندی شیرینگ و فله</span>
            <span>☎️ پاسخ‌گویی سریع</span>
        </div>
        <div class="ct-closing-actions">
            <a href="/Catalog" class="ct-closing-btn ct-closing-btn--primary">
                <span>مشاهده محصولات</span>
                <span class="ct-closing-btn-arrow" aria-hidden="true">←</span>
            </a>
            <a href="tel:@WholesaleRules.CoordinationPhone" class="ct-closing-btn ct-closing-btn--phone">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.89.3 1.77.57 2.61a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.84.27 1.72.45 2.61.57A2 2 0 0 1 22 16.92z"/></svg>
                <span>@WholesaleRules.CoordinationPhone</span>
            </a>
            <a href="/Page/Contact" class="ct-closing-btn ct-closing-btn--ghost">فرم تماس</a>
        </div>
    </div>
</section>
