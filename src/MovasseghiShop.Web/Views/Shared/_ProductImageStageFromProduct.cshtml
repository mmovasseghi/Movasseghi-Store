@model Product
@inject IWebHostEnvironment Env
@{
    var variant = ViewData["StageVariant"] as string ?? "card";
    var width = ViewData["StageWidth"] as int? ?? 220;
    var height = ViewData["StageHeight"] as int? ?? 220;
    var fetchPriority = ViewData["StageFetchPriority"] as bool? ?? false;
    var dualSlides = ProductImageHelper.ResolveDualCardSlides(Model.Images, Env, Model.Name);
    // Card/list stages are ≤ ~320 CSS px; prefer *-lcp.webp when present.
    var useCardSized = !string.Equals(variant, "detail", StringComparison.OrdinalIgnoreCase)
                       && width <= ProductImageHelper.LcpMaxCssPx;
    var studioUrl = useCardSized ? ProductImageHelper.PreferLcpVariant(dualSlides.StudioUrl, Env) : dualSlides.StudioUrl;
    var sceneUrl = useCardSized ? ProductImageHelper.PreferLcpVariant(dualSlides.SceneUrl, Env) : dualSlides.SceneUrl;
}
@await Html.PartialAsync("_ProductImageStage", new ProductImageStageModel
{
    ImageUrl = studioUrl,
    Alt = dualSlides.StudioAlt,
    AlternateImageUrl = sceneUrl,
    AlternateAlt = dualSlides.SceneAlt,
    DualCycle = (ViewData["StageDualCycle"] as bool? ?? true) && dualSlides.CanCycle,
    Variant = variant,
    Width = width,
    Height = height,
    FetchPriority = fetchPriority
})
