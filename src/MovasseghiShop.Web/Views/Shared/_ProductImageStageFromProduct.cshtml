@model Product
@inject IWebHostEnvironment Env
@{
    var variant = ViewData["StageVariant"] as string ?? "card";
    var width = ViewData["StageWidth"] as int? ?? 220;
    var height = ViewData["StageHeight"] as int? ?? 220;
    var fetchPriority = ViewData["StageFetchPriority"] as bool? ?? false;
    var dualSlides = ProductImageHelper.ResolveDualCardSlides(Model.Images, Env, Model.Name);
}
@await Html.PartialAsync("_ProductImageStage", new ProductImageStageModel
{
    ImageUrl = dualSlides.StudioUrl,
    Alt = dualSlides.StudioAlt,
    AlternateImageUrl = dualSlides.SceneUrl,
    AlternateAlt = dualSlides.SceneAlt,
    DualCycle = (ViewData["StageDualCycle"] as bool? ?? true) && dualSlides.CanCycle,
    Variant = variant,
    Width = width,
    Height = height,
    FetchPriority = fetchPriority,
    Sizes = variant switch
    {
        "offer" => "(min-width: 768px) 160px, 112px",
        "featured" => "(min-width: 768px) 160px, 34vw",
        "search" => "40px",
        _ => "(min-width: 1024px) 240px, 45vw"
    }
})
