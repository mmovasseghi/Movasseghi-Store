@model IEnumerable<NewsItem>
@using System.Text.Json
@{
    var breaking = (IEnumerable<NewsItem>)ViewBag.Breaking ?? Enumerable.Empty<NewsItem>();
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var total = (int)ViewBag.Total;
    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/News{(page > 1 ? $"?page={page}" : "")}";

    ViewData["Title"] = page > 1 ? $"اخبار — صفحه {page} | فروشگاه موثقی" : "اخبار | فروشگاه موثقی — نمایندگی رسمی آملون";
    ViewData["MetaDescription"] = "آخرین اخبار فروشگاه موثقی — نمایندگی رسمی آملون در تهران. ورود محصولات جدید، تخفیف‌های عمده، ارسال و رویدادهای پخش ظروف گیاهی.";
    ViewData["MetaKeywords"] = "اخبار موثقی, اخبار آملون, ظروف گیاهی, پخش عمده تهران";
    ViewData["CanonicalUrl"] = pageUrl;
    ViewData["OgTitle"] = ViewData["Title"];
    ViewData["OgDescription"] = ViewData["MetaDescription"];
    ViewData["OgType"] = "website";
    ViewData["OgUrl"] = pageUrl;
    ViewData["OgImage"] = AppPath.Absolute("/images/brand/originallogo.png", Context);
}
@section Head {
    <link rel="stylesheet" href="~/css/ux-content.css" asp-append-version="true" />
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "CollectionPage",
        ["name"] = "اخبار فروشگاه موثقی",
        ["description"] = ViewData["MetaDescription"],
        ["url"] = pageUrl,
        ["mainEntity"] = new Dictionary<string, object?>
        {
            ["@type"] = "ItemList",
            ["itemListElement"] = Model.Select((item, i) => new Dictionary<string, object?>
            {
                ["@type"] = "ListItem",
                ["position"] = i + 1,
                ["item"] = new Dictionary<string, object?>
                {
                    ["@type"] = "NewsArticle",
                    ["headline"] = item.Title,
                    ["url"] = $"{Context.Request.Scheme}://{Context.Request.Host}/News/Article/{item.Slug}",
                    ["datePublished"] = (item.PublishedAt ?? item.CreatedAt).ToString("o")
                }
            }).ToList()
        }
    }))</script>
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "خانه", ["item"] = $"{Context.Request.Scheme}://{Context.Request.Host}/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "اخبار", ["item"] = pageUrl }
        }
    }))</script>
}

<div class="ms-wrap ct-page ct-page--news" data-ct-page>
    @{ ViewBag.ContentHeroMode = "news"; ViewBag.ContentTotal = total; }
    <partial name="_ContentPageHero" />

    <nav class="ct-breadcrumb" aria-label="مسیر صفحه">
        <a href="@AppPath.H("/", Context)">خانه</a><span aria-hidden="true">/</span><span aria-current="page">اخبار</span>
    </nav>

    @{
        var breakingList = breaking.ToList();
    }
    @if (breakingList.Count > 0 && page == 1)
    {
        <section class="ct-breaking ms-reveal" aria-label="اخبار فوری">
            <h2 class="ct-breaking-label">🔴 فوری</h2>
            <div class="ct-breaking-list">
                @foreach (var item in breakingList)
                {
                    <a href="/News/Article/@item.Slug" class="ct-breaking-item">@item.Title</a>
                }
            </div>
        </section>
    }

    @if (Model.Any())
    {
        <div class="ct-grid ct-grid--news ms-reveal">
            @foreach (var item in Model)
            {
                var pubDate = item.PublishedAt ?? item.CreatedAt;
                <article class="ct-card ct-card--news">
                    <a href="/News/Article/@item.Slug" class="ct-card-link">
                        <div class="ct-card-visual @(item.FeaturedImageUrl?.Contains("/products/") == true ? "ct-card-visual--photo" : "ms-img-stage")">
                            @if (!string.IsNullOrEmpty(item.FeaturedImageUrl))
                            {
                                <img src="@AppPath.H(item.FeaturedImageUrl, Context)" alt="@item.Title" width="320" height="180" loading="lazy" />
                            }
                        </div>
                        <div class="ct-card-body">
                            @if (item.IsBreaking)
                            {
                                <span class="ct-badge ct-badge--urgent">فوری</span>
                            }
                            <time class="ct-date" datetime="@pubDate.ToString("yyyy-MM-dd")">@pubDate.ToLocalTime().ToString("yyyy/MM/dd")</time>
                            <h2 class="ct-card-title">@item.Title</h2>
                            @if (!string.IsNullOrWhiteSpace(item.Excerpt))
                            {
                                <p class="ct-card-excerpt">@item.Excerpt</p>
                            }
                            <span class="ct-read-more">مشاهده خبر ←</span>
                        </div>
                    </a>
                </article>
            }
        </div>
    }
    else
    {
        <div class="ct-empty">هنوز خبری منتشر نشده است.</div>
    }

    @if (totalPages > 1)
    {
        <nav class="ct-pagination" aria-label="صفحه‌بندی اخبار">
            @if (page > 1)
            {
                <a href="/News?page=@(page - 1)" class="ct-page-btn">→ قبلی</a>
            }
            @for (var i = 1; i <= totalPages; i++)
            {
                <a href="/News?page=@i" class="ct-page-num @(i == page ? "is-active" : "")" @(i == page ? "aria-current=page" : "")>@i</a>
            }
            @if (page < totalPages)
            {
                <a href="/News?page=@(page + 1)" class="ct-page-btn">بعدی ←</a>
            }
        </nav>
    }

    <partial name="_ContentPageCta" />
</div>

@section Scripts {
    <script defer src="~/js/content.js" asp-append-version="true"></script>
}
